{
  "$schema": "../../../../packages/sdk/schemas/scenario.schema.json",
  "name": "seed 42: the machine breaks on day 3 and is repaired at 10:00",
  "seed": 42,
  "days": 4,
  "rules": {
    "expect": {
      "commands": [
        { "day": 3, "step": 36000, "hook": "onDayStart", "command": { "type": "DeviceFault", "device_kind": "coffee-machine", "day": 3 } },
        { "day": 3, "step": 36000, "hook": "onDayStart", "command": { "type": "MoodBeat", "people": "all", "delta_permille": -20, "reason": "coffee-machine-broke" } },
        { "day": 3, "step": 37500, "hook": "onStep", "command": { "type": "DeviceRepaired", "device_kind": "coffee-machine", "day": 3 } }
      ]
    }
  }
}
