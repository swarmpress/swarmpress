# The fork rehearsal (docs/runbooks/fork-rehearsal.md): the central server
# against your fork of swarmpress/cinqueterre.travel on the real GitHub.
#
#   cp .env.rehearsal.example .env.rehearsal.local    # git-ignored: it holds your token
#   # replace every YOUR_GITHUB_LOGIN, paste the token
#   scripts/run-local.sh --env .env.rehearsal.local --build
#
# The values the server refuses with a real GitHub are absent on purpose:
# SWARMPRESS_SIMULATE_DEPLOY, SWARMPRESS_FAKE_SITE, SWARMPRESS_ARTICLE_PROFILE=off.

# A database and data directory of its own: the rehearsal company never mixes
# with the fake-GitHub company of .env (both under the git-ignored data/).
DATABASE_URL=sqlite://data/rehearsal/swarmpress.db?mode=rwc
SWARMPRESS_DATA_DIR=data/rehearsal

# One origin: the built game and the API on the server's address.
SWARMPRESS_BIND=127.0.0.1:8080
SWARMPRESS_PUBLIC_URL=http://localhost:8080
SWARMPRESS_STATIC_DIR=apps/game/dist
SWARMPRESS_TRACKER_ORIGIN=http://localhost:8080

# Dev login: allowed with a real GitHub on a loopback address only.
SWARMPRESS_DEV_AUTH=1

# Token mode. A fine-grained personal access token with access to the fork
# only: Contents read/write, Pull requests read/write, Actions read, Metadata
# read (from GitHub's documentation, not verified yet).
SWARMPRESS_GITHUB=real
GITHUB_TOKEN=

# The repository the company writes to, and the only one it may.
SWARMPRESS_DEFAULT_SITE_REPO=YOUR_GITHUB_LOGIN/cinqueterre.travel
SWARMPRESS_DEFAULT_BASE_BRANCH=main
SWARMPRESS_ALLOWED_SITE_REPOS=YOUR_GITHUB_LOGIN/cinqueterre.travel

# Deploys are observed by polling the merge commit's check runs; the site's
# deploy workflow publishes in its job `deploy`.
SWARMPRESS_DEPLOY_CHECK=deploy
SWARMPRESS_DEPLOY_POLL_SECS=30
SWARMPRESS_DEPLOY_POLL_MAX_AGE_SECS=3600

# The mail domain of the staff personas' git author addresses. Choose it
# before the first live merge: the site's history is not rewritten.
# SWARMPRESS_STAFF_EMAIL_DOMAIN=staff.swarm.press

RUST_LOG=info,sqlx=warn
