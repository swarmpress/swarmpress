{
  "name": "Lead intake",
  "nodes": [
    { "parameters": { "httpMethod": "POST", "path": "lead", "responseMode": "responseNode", "options": {} },
      "id": "5f0c", "name": "Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 0], "webhookId": "a1" },
    { "parameters": { "mode": "manual", "duplicateItem": false, "assignments": { "assignments": [
        { "id": "e1", "name": "email", "value": "={{ $json.body.email.trim().toLowerCase() }}", "type": "string" },
        { "id": "e2", "name": "domain", "value": "={{ $json.body.email.trim().toLowerCase().extractDomain() }}", "type": "string" },
        { "id": "e3", "name": "seats", "value": "={{ $json.body.seats }}", "type": "number" },
        { "id": "e4", "name": "received", "value": "={{ $now.toISODate() }}", "type": "string" } ] },
        "includeOtherFields": false, "options": {} },
      "id": "6a1d", "name": "Normalize", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [220, 0] },
    { "parameters": { "method": "POST", "url": "https://api.example-crm.com/v1/companies/lookup",
        "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "X-Api-Key", "value": "demo-key" }] },
        "sendBody": true, "specifyBody": "json", "jsonBody": "={ \"domain\": \"{{ $json.domain }}\" }", "options": {} },
      "id": "7b2e", "name": "Lookup company", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
        "conditions": [ { "id": "c1", "leftValue": "={{ $('Normalize').item.json.seats }}", "rightValue": 50, "operator": { "type": "number", "operation": "gte" } },
                        { "id": "c2", "leftValue": "={{ $json.company.size }}", "rightValue": "enterprise", "operator": { "type": "string", "operation": "equals" } } ],
        "combinator": "or" }, "options": {} },
      "id": "8c3f", "name": "Big deal?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [660, 0] },
    { "parameters": { "mode": "runOnceForEachItem", "jsCode": "const lead = $('Normalize').item.json;\nreturn { json: { email: lead.email, company: $json.company.name, tier: 'priority', score: lead.seats * 2 } };" },
      "id": "9d40", "name": "Priority", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, -100] },
    { "parameters": { "assignments": { "assignments": [
        { "id": "f1", "name": "email", "value": "={{ $('Normalize').item.json.email }}", "type": "string" },
        { "id": "f2", "name": "company", "value": "={{ $json.company.name }}", "type": "string" },
        { "id": "f3", "name": "tier", "value": "standard", "type": "string" } ] }, "options": {} },
      "id": "ae51", "name": "Standard", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [880, 100] },
    { "parameters": {}, "id": "bf62", "name": "Merge", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1100, 0] },
    { "parameters": { "respondWith": "allIncomingItems", "options": {} },
      "id": "c073", "name": "Respond to Webhook", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.1, "position": [1320, 0] },
    { "parameters": { "content": "## Lead intake\nNormalizes, enriches and routes leads." },
      "id": "d184", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [0, -200] }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]] },
    "Normalize": { "main": [[{ "node": "Lookup company", "type": "main", "index": 0 }]] },
    "Lookup company": { "main": [[{ "node": "Big deal?", "type": "main", "index": 0 }]] },
    "Big deal?": { "main": [[{ "node": "Priority", "type": "main", "index": 0 }], [{ "node": "Standard", "type": "main", "index": 0 }]] },
    "Priority": { "main": [[{ "node": "Merge", "type": "main", "index": 0 }]] },
    "Standard": { "main": [[{ "node": "Merge", "type": "main", "index": 1 }]] },
    "Merge": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true }
}
