{
  "$ref": "#/definitions/SiteManifest",
  "definitions": {
    "SiteManifest": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "base": {
          "type": "string",
          "pattern": "^\\/",
          "default": "/"
        },
        "domain": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
          },
          "minItems": 1
        },
        "defaultLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
        },
        "brand": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "tagline": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "propertyNames": {
                    "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
                  }
                }
              ]
            },
            "logo": {
              "type": "string",
              "pattern": "^(media:[A-Za-z0-9][A-Za-z0-9._-]*|https?:\\/\\/\\S+|\\/([^/\\s]\\S*)?)$"
            },
            "favicon": {
              "type": "string",
              "pattern": "^(media:[A-Za-z0-9][A-Za-z0-9._-]*|https?:\\/\\/\\S+|\\/([^/\\s]\\S*)?)$"
            },
            "voiceRef": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "regions": {
          "type": "object",
          "properties": {
            "label": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "propertyNames": {
                    "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
                  }
                }
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        },
                        "propertyNames": {
                          "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
                        }
                      }
                    ]
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "color": {
                    "type": "string"
                  },
                  "geo": {
                    "type": "object",
                    "properties": {
                      "lat": {
                        "type": "number"
                      },
                      "lng": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "lat",
                      "lng"
                    ],
                    "additionalProperties": false
                  },
                  "entityRef": {
                    "type": "string"
                  }
                },
                "required": [
                  "slug",
                  "name",
                  "order"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "label",
            "items"
          ],
          "additionalProperties": false
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
                    }
                  }
                ]
              },
              "collection": {
                "type": "string"
              },
              "perRegion": {
                "type": "boolean",
                "default": false
              },
              "hubPage": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "label"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "propertyNames": {
                      "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,4})?$"
                    }
                  }
                ]
              },
              "schema": {
                "type": "string"
              },
              "detailRoute": {
                "type": "boolean",
                "default": false
              },
              "itemKey": {
                "type": "string",
                "default": "slug"
              },
              "regionField": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "dir"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "routes": {
          "type": "object",
          "properties": {
            "home": {
              "type": "string"
            },
            "blogIndex": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "analytics": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "projectKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "endpoint",
            "projectKey"
          ],
          "additionalProperties": false
        },
        "screenshotPages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\/"
          },
          "default": [
            "/"
          ]
        },
        "themeDir": {
          "type": "string",
          "default": "theme"
        }
      },
      "required": [
        "schemaVersion",
        "siteId",
        "baseUrl",
        "languages",
        "defaultLanguage",
        "brand"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
