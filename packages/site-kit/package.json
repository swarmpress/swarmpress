{
  "name": "@swarm-press/site-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "Platform-owned Astro 5 integration for SimPress sites: routing, content loading + validation, i18n, SEO, block registry, closed-world links/media and the `kit` CLI. Themes only own presentation.",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./components/*": "./components/*",
    "./routes/*": "./routes/*",
    "./styles/*": "./styles/*",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "kit": "./bin/kit.mjs"
  },
  "files": [
    "bin",
    "src",
    "components",
    "routes",
    "styles",
    "schema",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/integration/**",
    "typecheck": "tsc --noEmit",
    "schema:export": "tsx scripts/export-manifest-schema.ts",
    "schema:check": "tsx scripts/export-manifest-schema.ts --check",
    "kit": "node bin/kit.mjs"
  },
  "peerDependencies": {
    "astro": "^5.1.0"
  },
  "dependencies": {
    "@swarm-press/content-schema": "workspace:*",
    "@tailwindcss/vite": "^4.1.15",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "astro": "^5.16.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
