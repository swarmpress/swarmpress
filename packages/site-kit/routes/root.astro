---
/** `/` — sends visitors to the default language home (static hosting has no server redirects). */
import config from 'virtual:site-kit/config'
import { absoluteUrl, routeUrl } from '../src/resolve'

const m = config.manifest
const target = routeUrl(m.base, `/${m.defaultLanguage}`)
const canonical = absoluteUrl(m.baseUrl, m.base, `/${m.defaultLanguage}`)
---

<!doctype html>
<html lang={m.defaultLanguage}>
  <head>
    <meta charset="utf-8" />
    <title>{m.brand.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    {m.languages.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(m.baseUrl, m.base, `/${l}`)} />)}
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{m.brand.name}</a></p>
  </body>
</html>
