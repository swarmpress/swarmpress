---
/** A resolved MediaRef as <img> (lazy by default, alt from content or the media index). */
import type { RenderContext } from '../src/context'

interface Props {
  src: unknown
  alt?: unknown
  ctx: RenderContext
  class?: string
  eager?: boolean
  sizes?: string
}
const { src, alt, ctx, class: cls, eager = false } = Astro.props as Props
const m = ctx.media(src)
const altText = ctx.l(alt) || m?.alt || ''
---

{
  m && (
    <img
      src={m.src}
      alt={altText}
      class={cls}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      width={m.width}
      height={m.height}
      fetchpriority={eager ? 'high' : undefined}
    />
  )
}
