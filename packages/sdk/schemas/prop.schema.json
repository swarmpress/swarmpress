{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swarm.press/sdk/0.1.0/prop.schema.json",
  "title": "prop",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ],
      "additionalProperties": {
        "type": "string"
      },
      "description": "Language code → text; `en` is required"
    },
    "gltf": {
      "type": "string",
      "minLength": 1
    },
    "textures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "footprint": {
      "type": "object",
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "sit",
              "stand",
              "use",
              "look"
            ]
          },
          "at": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "facing": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "kind",
          "at"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "point",
              "spot",
              "area"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "intensity": {
            "type": "number",
            "minimum": 0
          },
          "at": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          }
        },
        "required": [
          "kind",
          "color",
          "intensity",
          "at"
        ],
        "additionalProperties": false
      },
      "maxItems": 2,
      "default": []
    }
  },
  "required": [
    "id",
    "name",
    "gltf",
    "footprint"
  ],
  "additionalProperties": false
}
