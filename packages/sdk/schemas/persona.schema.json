{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simpress.dev/sdk/0.1.0/persona.schema.json",
  "title": "persona",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "display_role": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "editor_in_chief",
        "writer",
        "editor",
        "qa",
        "art_director",
        "frontend_dev",
        "seo",
        "linker",
        "researcher",
        "media",
        "translator",
        "chatter",
        "critic"
      ]
    },
    "seniority": {
      "type": "string",
      "enum": [
        "junior",
        "mid",
        "senior",
        "star"
      ]
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "voice_characteristics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "traits": {
      "type": "object",
      "properties": {
        "rigor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "speed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "creativity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sociability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "resilience": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ambition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "rigor",
        "speed",
        "creativity",
        "sociability",
        "resilience",
        "ambition"
      ],
      "additionalProperties": false
    },
    "writing_style": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "string"
        },
        "vocabulary_level": {
          "type": "string"
        },
        "sentence_length": {
          "type": "string"
        },
        "formality": {
          "type": "string"
        },
        "humor": {
          "type": "string"
        },
        "emoji_usage": {
          "type": "string"
        },
        "perspective": {
          "type": "string"
        },
        "descriptive_style": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "content_preferences": {
      "type": "object",
      "properties": {
        "opening_style": {
          "type": "string"
        },
        "structure_preference": {
          "type": "string"
        },
        "closing_style": {
          "type": "string"
        },
        "favorite_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "opening_style",
        "structure_preference",
        "closing_style",
        "favorite_topics",
        "avoid_topics"
      ],
      "additionalProperties": false
    },
    "sample_phrases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      }
    }
  },
  "required": [
    "name",
    "display_role",
    "role",
    "seniority",
    "expertise",
    "persona",
    "background",
    "voice_characteristics",
    "traits",
    "writing_style",
    "content_preferences",
    "sample_phrases"
  ],
  "additionalProperties": false
}
