{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://simpress.dev/sdk/0.1.0/prompt-layer.schema.json",
  "title": "prompt-layer",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "writer",
        "editor",
        "editor_in_chief",
        "meeting_speaker",
        "qa_coherence"
      ]
    },
    "template_additions": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {}
    },
    "variables": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "applies_to"
  ],
  "additionalProperties": false
}
