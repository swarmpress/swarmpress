# swarm.press central server configuration. Copy to .env and fill in.
# Defaults below are for local development (fake GitHub, dev login).
# Against a real repository (the fork rehearsal, later the live site) start
# from .env.rehearsal.example instead (docs/runbooks/fork-rehearsal.md).

# SQLite (ADR-0039): created on first start, migrated at startup.
DATABASE_URL=sqlite://data/swarmpress.db?mode=rwc
# Sync blobs (command-log segments, snapshots)
SWARMPRESS_DATA_DIR=data

# HTTP / WebSocket listener
SWARMPRESS_BIND=127.0.0.1:8080
# Public origin of the game client (cookies, OAuth redirect). The built game
# is served by this server on its own origin (SWARMPRESS_STATIC_DIR below;
# scripts/run-local.sh), so this is the server's address. With `pnpm dev`
# (Vite on :5173, proxying /auth /api /ws /web here) dev login works either
# way; set http://localhost:5173 only for GitHub sign-in through Vite.
SWARMPRESS_PUBLIC_URL=http://localhost:8080

# Development only: POST /auth/dev/login {"login": "..."} signs anyone in.
# With a real GitHub the server refuses it unless SWARMPRESS_BIND is a
# loopback address.
SWARMPRESS_DEV_AUTH=1

# Content gateway: `fake` = in-memory FakeGitHub (repos created on demand,
# lost on restart); unset or `real` = the real GitHub with GITHUB_TOKEN or the
# App, which also requires SWARMPRESS_ALLOWED_SITE_REPOS.
SWARMPRESS_GITHUB=fake

# Which repository a company writes to (increment G2, ADR-0047).
# The binding a new company gets: the game passes it when it founds the
# company and shows it on the boot screen and in the HUD. Without it a new
# company gets {GITHUB_SITES_ORG}/{login}-site on main. An existing company
# keeps its binding; PATCH /api/companies/me rebinds it (with the lease).
# SWARMPRESS_DEFAULT_SITE_REPO=owner/name
# SWARMPRESS_DEFAULT_BASE_BRANCH=main
# The only repositories a company may be bound to or write to, comma-separated
# owner/name (compared without case). Required with a real GitHub (the server
# does not start without it); empty with the fake means any.
# SWARMPRESS_ALLOWED_SITE_REPOS=owner/name
# Emit DeployLanded right after a gateway merge (default: on with the fake).
# With a real GitHub this is a startup error: deploys are then observed by
# polling the merge commit's check runs (SWARMPRESS_DEPLOY_POLL_SECS, ...).
# SWARMPRESS_SIMULATE_DEPLOY=1
# The gateway validates blog articles against the article profile (ADR-0061).
# The scripted orchestrator (`?llm=fake`) still writes the pre-MVP article
# shape, which the profile refuses with 422; `off` (fake GitHub only) lets it
# through. Remove once the orchestrator assembles the new shape.
SWARMPRESS_ARTICLE_PROFILE=off
# Mail domain of the git author addresses synthesised for staff personas.
# SWARMPRESS_STAFF_EMAIL_DOMAIN=staff.swarm.press

# GitHub OAuth app (player login)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Real GitHub for the content gateway: a token, or the GitHub App.
# Token mode (the MVP): a fine-grained token on the site repository only, with
# Contents read/write, Pull requests read/write, Actions read and Metadata
# read (from GitHub's documentation, not verified yet).
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# deployment_status webhooks (POST /webhooks/github)
GITHUB_WEBHOOK_SECRET=
# Owner of default site repos ({org}/{login}-site) when SWARMPRESS_DEFAULT_SITE_REPO is unset
GITHUB_SITES_ORG=swarmpress-sites

# Claude (Agency jobs, later waves)
ANTHROPIC_API_KEY=

# --- Server tuning (all optional; defaults shown) ---
# Built game client served at / (empty = don't serve static files): `pnpm build`
# writes it; scripts/run-local.sh serves it on SWARMPRESS_PUBLIC_URL.
SWARMPRESS_STATIC_DIR=apps/game/dist
# Cross-origin isolation for the served client (Turso wasm needs it, ADR-0041):
# credentialless (default) | require-corp | off
SWARMPRESS_COEP=credentialless
SWARMPRESS_SESSION_TTL_SECS=2592000
# Company lease (one device holds a company)
SWARMPRESS_LEASE_SECS=90
# Largest sync upload in bytes
SWARMPRESS_SYNC_MAX_BYTES=67108864
# Per-user token bucket for GET /web/fetch
SWARMPRESS_WEB_FETCH_RATE_PER_MIN=30
SWARMPRESS_WEB_FETCH_BURST=10
# Override GitHub endpoints (tests / GitHub Enterprise)
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_URL=https://api.github.com
# Log filter
RUST_LOG=info,sqlx=warn

# First-party analytics tracker (ADR-0032): public origin that site scripts
# beacon to (POST {origin}/t/e). Raw events are kept at most this many days.
SWARMPRESS_TRACKER_ORIGIN=http://localhost:8080
SWARMPRESS_TRACKER_RAW_RETENTION_DAYS=7
# Accept events from localhost origins (default: on when SWARMPRESS_PUBLIC_URL is localhost).
# SWARMPRESS_TRACKER_ALLOW_LOCALHOST=true
# Behind a reverse proxy: take the client IP from the first X-Forwarded-For hop
# (used only in memory for rate limiting and the salted visitor hash).
# SWARMPRESS_TRACKER_TRUST_PROXY=false
# Per-IP token bucket for POST /t/e.
# SWARMPRESS_TRACKER_RATE_PER_MIN=120
# SWARMPRESS_TRACKER_BURST=60
