# SimPress central server configuration. Copy to .env and fill in.
# Defaults below are for local development (fake GitHub, dev login).

# SQLite (ADR-0039): created on first start, migrated at startup.
DATABASE_URL=sqlite://data/simpress.db?mode=rwc
# Sync blobs (command-log segments, snapshots)
SIMPRESS_DATA_DIR=data

# HTTP / WebSocket listener
SIMPRESS_BIND=127.0.0.1:8080
# Public origin of the game client (cookies, OAuth redirect)
SIMPRESS_PUBLIC_URL=http://localhost:5173

# Development only: POST /auth/dev/login {"login": "..."} signs anyone in.
SIMPRESS_DEV_AUTH=1

# Content gateway: `fake` = in-memory FakeGitHub (repos created on demand,
# lost on restart); anything else = the real GitHub with GITHUB_TOKEN or the App.
SIMPRESS_GITHUB=fake
# Emit DeployLanded right after a gateway merge (default: on with the fake).
# SIMPRESS_SIMULATE_DEPLOY=1

# GitHub OAuth app (player login)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Real GitHub for the content gateway: a token, or the GitHub App.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# deployment_status webhooks (POST /webhooks/github)
GITHUB_WEBHOOK_SECRET=
# Owner of default site repos ({org}/{login}-site)
GITHUB_SITES_ORG=simpress-sites

# Claude (Agency jobs, later waves)
ANTHROPIC_API_KEY=

# --- Server tuning (all optional; defaults shown) ---
# Built game client served at / (empty = don't serve static files)
SIMPRESS_STATIC_DIR=apps/game/dist
# Cross-origin isolation for the served client (Turso wasm needs it, ADR-0041):
# credentialless (default) | require-corp | off
SIMPRESS_COEP=credentialless
SIMPRESS_SESSION_TTL_SECS=2592000
# Company lease (one device holds a company)
SIMPRESS_LEASE_SECS=90
# Largest sync upload in bytes
SIMPRESS_SYNC_MAX_BYTES=67108864
# Per-user token bucket for GET /web/fetch
SIMPRESS_WEB_FETCH_RATE_PER_MIN=30
SIMPRESS_WEB_FETCH_BURST=10
# Override GitHub endpoints (tests / GitHub Enterprise)
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_URL=https://api.github.com
# Log filter
RUST_LOG=info,sqlx=warn

# First-party analytics tracker (ADR-0032): public origin that site scripts
# beacon to (POST {origin}/t/e). Raw events are kept at most this many days.
SIMPRESS_TRACKER_ORIGIN=http://localhost:8080
SIMPRESS_TRACKER_RAW_RETENTION_DAYS=7
# Accept events from localhost origins (default: on when SIMPRESS_PUBLIC_URL is localhost).
# SIMPRESS_TRACKER_ALLOW_LOCALHOST=true
# Behind a reverse proxy: take the client IP from the first X-Forwarded-For hop
# (used only in memory for rate limiting and the salted visitor hash).
# SIMPRESS_TRACKER_TRUST_PROXY=false
# Per-IP token bucket for POST /t/e.
# SIMPRESS_TRACKER_RATE_PER_MIN=120
# SIMPRESS_TRACKER_BURST=60
