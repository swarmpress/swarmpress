# SimPress server configuration. Copy to .env and fill in.

# Postgres (docker compose up -d starts one on localhost)
DATABASE_URL=postgres://simpress:simpress@localhost:5432/simpress

# HTTP / WebSocket listener
SIMPRESS_BIND=127.0.0.1:8080
# Public origin of the game client (cookies, OAuth redirect)
SIMPRESS_PUBLIC_URL=http://localhost:5173

# Claude (Agency jobs: research, design/themes, escalations)
ANTHROPIC_API_KEY=

# GitHub OAuth app (player login)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub App (site repos: content and theme PRs, webhooks)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Platform org that owns new players' site repos
GITHUB_SITES_ORG=

# --- Server tuning (all optional; defaults shown) ---
# Built game client served at / (empty = don't serve static files)
SIMPRESS_STATIC_DIR=apps/game/dist
# Real minutes per game day for new companies
SIMPRESS_DAY_REAL_MINUTES=60
SIMPRESS_SESSION_TTL_SECS=2592000
# Lockstep: Hash frame cadence, snapshot cadence, catch-up budget per 100 ms tick
SIMPRESS_HASH_EVERY_STEPS=600
SIMPRESS_SNAPSHOT_EVERY_STEPS=6000
SIMPRESS_CATCHUP_STEPS_PER_TICK=2000
# Unload a company actor after this long with no connected tabs
SIMPRESS_IDLE_UNLOAD_SECS=300
# Job queue
SIMPRESS_JOB_LEASE_SECS=60
SIMPRESS_JOB_REAP_SECS=5
SIMPRESS_CLAUDE_CONCURRENCY=4
SIMPRESS_MAX_ARTIFACT_BYTES=262144
# Override GitHub OAuth endpoints (tests / GitHub Enterprise)
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_URL=https://api.github.com
# Log filter
RUST_LOG=info,sqlx=warn

# Google Analytics 4 (Data Scientist / AnalyticsSync, ADR-0032).
# Service account JSON key with Viewer access on each project's GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=
