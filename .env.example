# Database
DATABASE_URL=postgresql://swarmpress:swarmpress@localhost:5432/swarmpress

# NATS
NATS_URL=nats://localhost:4222

# Temporal
TEMPORAL_URL=localhost:7233
# Alias used by some Temporal SDK examples; defaults to TEMPORAL_URL
TEMPORAL_ADDRESS=localhost:7233
# Temporal namespace (default workspace)
TEMPORAL_NAMESPACE=default

# Claude API
ANTHROPIC_API_KEY=your_api_key_here

# Backend API
API_PORT=3000
API_SECRET=your_secret_key_here

# Public URL of the backend API (consumed by admin/dashboard apps)
API_URL=http://localhost:3000
# Server-side base URL the admin/dashboard uses to reach the backend
BACKEND_API_URL=http://localhost:3000

# Symmetric key used to encrypt per-website tool secrets in the DB
TOOL_SECRET_KEY=change_me_to_a_random_32_byte_string

# CEO Authentication
CEO_EMAIL=ceo@swarm.press
CEO_PASSWORD=changeme

# GitHub OAuth (for user authentication)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:4321/auth/github/callback

# GitHub Integration (for collaboration and governance)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org
GITHUB_REPO=swarmpress-content
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Smee.io Webhook Proxy (for local development)
# Get your URL at https://smee.io - Click "Start a new channel"
SMEE_WEBHOOK_URL=https://smee.io/YOUR_CHANNEL_ID

# Optional override for the GitHub OAuth callback used by the website-level
# repo connector flow (separate from the user OAuth flow above)
GITHUB_REPO_CALLBACK_URL=http://localhost:4321/auth/github/repo-callback

# Or use GitHub App (alternative to token - more secure for production)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# GITHUB_INSTALLATION_ID=78910

# CORS
CORS_ORIGIN=*

# Environment
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# Media Storage (Cloudflare R2 - S3-compatible, zero egress costs)
# =============================================================================
# Get credentials at: https://dash.cloudflare.com > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=swarmpress-media
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.example.com
# R2 region is "auto" by default; set if you provisioned a specific region
R2_REGION=auto
# Storage provider for media: 'r2' | 's3' | 'spaces'
R2_PROVIDER=r2

# Generic media storage overrides (used when not bound to R2 specifically)
MEDIA_STORAGE_PROVIDER=r2
MEDIA_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_BUCKET=swarmpress-media
MEDIA_STORAGE_ACCESS_KEY_ID=your_storage_access_key
MEDIA_STORAGE_SECRET_ACCESS_KEY=your_storage_secret_key
# Public CDN URL prefix for served media
MEDIA_CDN_URL=https://cdn.example.com

# =============================================================================
# AI Image Generation (Google Gemini/Imagen)
# =============================================================================
# Google API Key - for Gemini/Imagen image generation
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key
# Alternate alias used by some Gemini SDK code paths
GEMINI_API_KEY=your_google_api_key

# =============================================================================
# External APIs (for Cinqueterre.travel and similar websites)
# =============================================================================
# Google Places API - POIs, restaurants, hotels, attractions
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# OpenWeather API - Weather forecasts and climate data
OPENWEATHER_API_KEY=your_openweather_api_key

# Pexels API - Stock photography
PEXELS_API_KEY=your_pexels_api_key

# Unsplash API - Stock photography
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# =============================================================================
# Site Builder Content Directories
# =============================================================================
# These paths point to the content submodule for the site being built
# Used by the Astro themes to load page content, collections, and configs

# Root content directory (contains pages/, collections/, config/, blog/)
CONTENT_ROOT=./cinqueterre.travel/content

# Page content directory (JSON files for each page)
CONTENT_DIR=./cinqueterre.travel/content/pages

# Village configuration directory (village-specific JSON configs)
VILLAGE_CONFIG_DIR=./cinqueterre.travel/content/config/villages

# Collections directory (per-village structured records)
COLLECTIONS_DIR=./cinqueterre.travel/content/collections

# Blog directory (long-form articles managed via the editorial workflow)
BLOG_DIR=./cinqueterre.travel/content/blog

# Local checkout path for the content git submodule (used by sync workflows)
CONTENT_REPO_PATH=./cinqueterre.travel

# =============================================================================
# Preview Configuration
# =============================================================================
# URL of the Astro dev server for live preview in Page Editor
# Start with: pnpm --filter cinque-terre dev
PUBLIC_PREVIEW_URL=http://localhost:4322
