{
  "$description": "Starter editorial magazine tokens (W3C Design Tokens). Edit these first: the kit's fallback renderers and every starter component read them.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#fbfaf7", "$description": "Page background (warm paper)" },
    "surface": { "$value": "#f2eee6", "$description": "Cards, footer, region bar" },
    "fg": { "$value": "#1d1b18", "$description": "Body text (ink)" },
    "muted": { "$value": "#5e584f", "$description": "Secondary text; 6.6:1 on bg" },
    "border": { "$value": "#e2dccf" },
    "accent": { "$value": "#0d5c63", "$description": "Links, eyebrows, buttons; 7.1:1 on bg" },
    "accent-fg": { "$value": "#ffffff" },
    "accent-soft": { "$value": "#dcebea" },
    "ink": { "$value": "#14211f", "$description": "Dark sections (closing notes, interludes)" },
    "on-ink": { "$value": "#f4f1ea" }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
    "serif": { "$value": ["Iowan Old Style", "Palatino Linotype", "Book Antiqua", "Georgia", "serif"] }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": "0.75rem" },
    "pill": { "$value": "999px" }
  },
  "spacing": {
    "$type": "dimension",
    "gutter": { "$value": "1.25rem" }
  },
  "container": {
    "$type": "dimension",
    "prose": { "$value": "40rem" },
    "page": { "$value": "76rem" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "rgb(20 33 31 / 0.08)" } },
    "lift": { "$value": [
      { "offsetX": "0", "offsetY": "2px", "blur": "4px", "spread": "0", "color": "rgb(20 33 31 / 0.06)" },
      { "offsetX": "0", "offsetY": "12px", "blur": "24px", "spread": "-6px", "color": "rgb(20 33 31 / 0.18)" }
    ] }
  }
}
