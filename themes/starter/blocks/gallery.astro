---
/** gallery: responsive grid (carousel/masonry variants degrade to the grid). */
import type { RenderContext } from '@swarm-press/site-kit'

const { block, ctx } = Astro.props as { block: Record<string, any>; ctx: RenderContext }
const images = (Array.isArray(block.images) ? block.images : [])
  .map((im: any) => ({ m: ctx.media(im?.src), alt: ctx.l(im?.alt), caption: ctx.l(im?.caption) }))
  .filter((x: any) => x.m)
---

<section class="st-container my-12">
  <ul class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {
      images.map((x: any, i: number) => (
        <li class:list={[i === 0 && images.length > 2 && 'sm:col-span-2 sm:row-span-2']}>
          <figure class="h-full">
            <img src={x.m.src} alt={x.alt || x.m.alt || ''} loading="lazy" decoding="async" class="size-full min-h-48 rounded-card object-cover" />
            {x.caption && <figcaption class="mt-2 text-sm text-muted">{x.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
</section>
