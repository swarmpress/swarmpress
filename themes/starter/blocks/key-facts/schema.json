{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A compact box of key facts (label/value pairs), e.g. distance, duration, best season.",
  "properties": {
    "type": { "type": "string", "const": "x:key-facts" },
    "title": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } }
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } }
            ]
          },
          "value": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "required": ["en"], "additionalProperties": { "type": "string" } }
            ]
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      }
    }
  },
  "required": ["facts"],
  "additionalProperties": false,
  "x-block-meta": {
    "intent": "inform",
    "description": "Key facts at a glance; use once per page, near the top"
  }
}
