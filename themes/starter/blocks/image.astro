---
/** image: a wide figure with caption. */
import type { RenderContext } from '@swarm-press/site-kit'

const { block, ctx } = Astro.props as { block: Record<string, any>; ctx: RenderContext }
const m = ctx.media(block.src)
const caption = ctx.l(block.caption)
---

{
  m && (
    <figure class="st-container my-10">
      <img
        src={m.src}
        alt={ctx.l(block.alt) || m.alt || ''}
        width={block.width ?? m.width}
        height={block.height ?? m.height}
        loading="lazy"
        decoding="async"
        class="mx-auto w-full max-w-5xl rounded-card object-cover shadow-card"
      />
      {caption && <figcaption class="st-measure mt-3 text-sm text-muted">{caption}</figcaption>}
    </figure>
  )
}
