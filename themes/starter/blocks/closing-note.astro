---
/** closing-note: a dark reflective closing section with calls to action. */
import RichText from '@swarm-press/site-kit/components/RichText.astro'
import type { RenderContext } from '@swarm-press/site-kit'

const { block, ctx } = Astro.props as { block: Record<string, any>; ctx: RenderContext }
const raw = Array.isArray(block.actions) ? block.actions : Array.isArray(block.buttons) ? block.buttons : []
const actions = raw
  .map((a: any, i: number) => ({ label: ctx.l(a.label ?? a.text), href: ctx.href(a.href ?? a.url), primary: (a.variant ?? (i === 0 ? 'primary' : 'secondary')) === 'primary' }))
  .filter((a: any) => a.label && a.href)
---

<section class="mt-12 bg-ink py-16 text-on-ink md:py-24">
  <div class="st-container">
    <div class="mx-auto max-w-3xl text-center">
      {ctx.l(block.badge) && <p class="st-eyebrow" style="color:inherit;opacity:.75">{ctx.l(block.badge)}</p>}
      <h2 class="mt-3 font-serif text-3xl text-balance md:text-5xl">{ctx.l(block.title)}</h2>
      <div class="st-prose mt-6 text-left text-on-ink/90 md:text-center [&_a]:text-on-ink">
        <RichText value={block.content} ctx={ctx} />
      </div>
      {
        actions.length > 0 && (
          <p class="mt-8 flex flex-wrap justify-center gap-3">
            {actions.map((a: any) => (
              <a href={a.href} class:list={['st-button st-focus', !a.primary && 'st-button--ghost']}>
                {a.label}
              </a>
            ))}
          </p>
        )
      }
    </div>
  </div>
</section>
