{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarm.press/schema/kit/palette.schema.json",
  "title": "swarmpress.palette.v1",
  "description": "The construction kit's fixed colour palette. ids are internal and neutral; name is the product's own player-facing name. Material hints are integers in permille.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "colours"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "swarmpress.palette.v1" },
    "colours": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "hex", "class"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
          "name": { "type": "string", "minLength": 1 },
          "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "class": { "enum": ["solid", "metal", "transparent", "emissive"] },
          "rough": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "metal": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "alpha": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "emissive": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "glow": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    }
  }
}
