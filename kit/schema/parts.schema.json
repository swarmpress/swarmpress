{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swarm.press/schema/kit/parts.schema.json",
  "title": "swarmpress.parts.v1",
  "description": "Part catalogue file of the construction kit. size is [w, d, h]: studs along x and z at turn 0 (6.25 cm), plates up (2.5 cm). Standard parts (brick, plate, tile) are what the brick splitter emits; special parts are placed by part ops.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "parts"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "swarmpress.parts.v1" },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } }
  },
  "$defs": {
    "class": { "enum": ["solid", "metal", "transparent", "emissive"] },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "size", "geometry", "top", "bottom", "colours", "cost"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
        "kind": { "enum": ["brick", "plate", "tile", "special"] },
        "size": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 512 }, "minItems": 3, "maxItems": 3 },
        "geometry": {
          "enum": ["box", "tile", "baseplate", "round", "round-tile", "screen", "board", "paper", "window", "door", "lamp-head", "seat", "shelf"]
        },
        "top": { "description": "studs: one per cell; stud: one in the centre; smooth: none.", "enum": ["studs", "stud", "smooth"] },
        "bottom": { "enum": ["anti-studs", "flat"] },
        "colours": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/class" } },
        "tags": {
          "type": "array",
          "items": { "enum": ["screen", "transparent", "light-emitter", "door", "window", "seat", "paper", "shelf"] }
        },
        "surface": { "description": "The face that can carry an information surface.", "enum": ["front", "top"] },
        "cost": { "description": "Cents of in-game money.", "type": "integer", "minimum": 0 },
        "colour": { "description": "Default colour id.", "type": "string" }
      }
    }
  }
}
