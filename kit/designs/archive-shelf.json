{
  "$schema": "../schema/design.schema.json",
  "format": "swarmpress.design.v1",
  "id": "archive-shelf",
  "name": "Archive shelf",
  "footprint": [18, 7],
  "height": 78,
  "params": {
    "wood": { "type": "colour", "default": "chocolate" }
  },
  "ops": [
    { "op": "mirror", "axis": "x", "ops": [
      { "op": "box", "at": [0, 0, 0], "size": [1, 7, 76], "part": "brick", "colour": "$wood" }
    ] },
    { "op": "box", "at": [1, 0, 0], "size": [16, 1, 76], "part": "brick", "colour": "caramel" },
    { "op": "box", "at": [1, 1, 0], "size": [16, 6, 3], "part": "brick", "colour": "$wood" },
    { "op": "repeat", "count": 5, "step": [0, 0, 15], "ops": [
      { "op": "part", "part": "shelf-6x8", "at": [1, 1, 3], "turn": 1, "colour": "$wood" },
      { "op": "part", "part": "shelf-6x8", "at": [9, 1, 3], "turn": 1, "colour": "$wood" },
      { "op": "use", "design": "book-row", "at": [1, 1, 4], "name": "books" },
      { "op": "box", "at": [9, 1, 4], "size": [2, 5, 12], "part": "brick", "colour": "grey-dark" },
      { "op": "box", "at": [11, 1, 4], "size": [2, 5, 12], "part": "brick", "colour": "red-dark" },
      { "op": "box", "at": [13, 1, 4], "size": [2, 5, 11], "part": "brick", "colour": "grey-dark" },
      { "op": "box", "at": [15, 1, 4], "size": [2, 5, 12], "part": "brick", "colour": "navy" }
    ] },
    { "op": "box", "at": [0, 0, 76], "size": [18, 7, 2], "part": "brick", "colour": "$wood" }
  ],
  "tags": ["storage"],
  "provenance": { "kind": "kit" }
}
