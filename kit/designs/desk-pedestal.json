{
  "$schema": "../schema/design.schema.json",
  "format": "swarmpress.design.v1",
  "id": "desk-pedestal",
  "name": "Desk pedestal",
  "footprint": [7, 11],
  "height": 28,
  "params": {
    "body": { "type": "colour", "default": "grey-light" },
    "fronts": { "type": "colour", "default": "white" }
  },
  "ops": [
    { "op": "mirror", "axis": "x", "ops": [
      { "op": "part", "part": "round-plate-1x1", "at": [0, 0, 0], "colour": "black" },
      { "op": "part", "part": "round-plate-1x1", "at": [0, 8, 0], "colour": "black" }
    ] },
    { "op": "box", "at": [0, 0, 1], "size": [7, 9, 27], "part": "brick", "colour": "$body" },
    { "op": "box", "at": [0, 9, 1], "size": [7, 1, 27], "part": "brick", "colour": "$fronts" },
    { "op": "repeat", "count": 2, "step": [0, 0, 9], "ops": [
      { "op": "box", "at": [0, 9, 9], "size": [7, 1, 1], "part": "plate", "colour": "$body" }
    ] },
    { "op": "repeat", "count": 3, "step": [0, 0, 9], "ops": [
      { "op": "part", "part": "plate-1x2", "at": [2, 10, 5], "turn": 1, "colour": "grey-dark" }
    ] }
  ],
  "provenance": { "kind": "kit" }
}
