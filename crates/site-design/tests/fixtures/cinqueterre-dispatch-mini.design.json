  "parts": [
    {
      "slug": "header",
      "area": "header",
      "html": "<header style=\"border-top:3px solid #0F1E2E;border-bottom:1px solid #CFC6B6;background:#F3EFE7\">\n<div class=\"wrap\" style=\"min-height:76px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 32px;padding-top:10px;padding-bottom:10px\">\n<a href=\"#\" style=\"display:flex;align-items:baseline;gap:8px\"><span class=\"disp\" style=\"font-size:26px\">Cinque Terre</span><span class=\"disp\" style=\"font-size:26px;font-style:italic;color:#B5482F\">Dispatch</span></a>\n<nav aria-label=\"Villages\" style=\"display:flex;flex-wrap:wrap;gap:4px 24px\">\n<a class=\"nav-v\" href=\"#\"><span class=\"dot\" style=\"background:#D98C7A\"></span><span class=\"ul\">Riomaggiore</span></a>\n<a class=\"nav-v\" href=\"#\"><span class=\"dot\" style=\"background:#D9A441\"></span><span class=\"ul\">Manarola</span></a>\n<a class=\"nav-v\" href=\"#\"><span class=\"dot\" style=\"background:#9DAA7C\"></span><span class=\"ul\">Corniglia</span></a>\n<a class=\"nav-v\" href=\"#\"><span class=\"dot\" style=\"background:#7FA9C2\"></span><span class=\"ul\">Vernazza</span></a>\n<a class=\"nav-v\" href=\"#\"><span class=\"dot\" style=\"background:#E8C547\"></span><span class=\"ul\">Monterosso</span></a>\n</nav>\n<div style=\"display:flex;align-items:center;gap:16px\">\n<div class=\"mono\" style=\"display:flex;gap:10px;font-size:12px;letter-spacing:0.1em\"><a href=\"#\" style=\"font-weight:500;border-bottom:1px solid #0F1E2E\">EN</a><a href=\"#\" style=\"color:#3A4756\">DE</a><a href=\"#\" style=\"color:#3A4756\">FR</a><a href=\"#\" style=\"color:#3A4756\">IT</a></div>\n<a class=\"btn btn-p\" href=\"#\" style=\"height:44px;padding:0 20px;font-size:14px\">Plan your trip <span class=\"arr\">→</span></a>\n</div>\n</div>\n</header>",
      "templates": [
        "home"
      ],
      "variants": 1,
      "menus": [
        "villages"
      ]
    },
    {
      "slug": "footer",
      "area": "footer",
      "html": "<footer style=\"background:#F3EFE7;border-top:3px solid #0F1E2E\">\n<div class=\"wrap\" style=\"padding-top:64px;padding-bottom:40px;display:flex;flex-direction:column;gap:48px\">\n<div style=\"display:flex;flex-wrap:wrap;gap:40px 48px\">\n<div style=\"flex:2 1 300px;display:flex;flex-direction:column;gap:14px\">\n<a href=\"#\" style=\"display:flex;align-items:baseline;gap:8px\"><span class=\"disp\" style=\"font-size:36px\">Cinque Terre</span><span class=\"disp\" style=\"font-size:36px;font-style:italic;color:#B5482F\">Dispatch</span></a>\n<p style=\"margin:0;max-width:38ch;font-size:15px;line-height:1.6;color:#3A4756\">Slow journalism for the five villages — stories, stays, trails and the practical bits in between.</p>\n</div>\n\n<div style=\"flex:1 1 150px;display:flex;flex-direction:column;gap:4px\">\n<span class=\"mono\" style=\"font-size:11px;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:8px\">Explore</span>\n<a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Cinque Terre</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Itineraries</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Things to Do</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Sights</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Stories</span></a>\n</div>\n\n<div style=\"flex:1 1 150px;display:flex;flex-direction:column;gap:4px\">\n<span class=\"mono\" style=\"font-size:11px;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:8px\">Villages</span>\n<a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Riomaggiore</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Manarola</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Corniglia</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Vernazza</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Monterosso</span></a>\n</div>\n\n<div style=\"flex:1 1 150px;display:flex;flex-direction:column;gap:4px\">\n<span class=\"mono\" style=\"font-size:11px;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:8px\">Guides</span>\n<a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Food &amp; Drink</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Places to Stay</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Getting Around</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Weather</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Events</span></a>\n</div>\n\n<div style=\"flex:1 1 150px;display:flex;flex-direction:column;gap:4px\">\n<span class=\"mono\" style=\"font-size:11px;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:8px\">About</span>\n<a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">Our Team</span></a><a href=\"#\" style=\"font-size:15px;min-height:32px;display:flex;align-items:center\"><span class=\"ul\">FAQ</span></a>\n</div>\n\n</div>\n<div class=\"mono\" style=\"display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;font-size:12px;color:#3A4756;border-top:1px solid #CFC6B6;padding-top:16px\"><span>© 2026 Cinque Terre Dispatch</span><span>44.1270° N ·