{
  "graph": {
    "format": "swarmpress.tool.v1",
    "id": "news-digest",
    "name": {
      "en": "News digest"
    },
    "description": "Imported from n8n: News digest.",
    "inputs": {},
    "outputs": {
      "edit_fields": "Json[]"
    },
    "nodes": [
      {
        "kind": "n8n",
        "id": "rss-read",
        "name": "RSS Read",
        "type": "n8n-nodes-base.rssFeedRead",
        "version": 1,
        "parameters": {
          "url": "https://www.ansa.it/sito/notizie/topnews/topnews_rss.xml"
        },
        "inputs": 1,
        "outputs": 1
      },
      {
        "kind": "n8n",
        "id": "limit",
        "name": "Limit",
        "type": "n8n-nodes-base.limit",
        "version": 1,
        "parameters": {
          "maxItems": 5
        },
        "inputs": 1,
        "outputs": 1
      },
      {
        "kind": "n8n",
        "id": "edit-fields",
        "name": "Edit Fields",
        "type": "n8n-nodes-base.set",
        "version": 3.4,
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "a",
                "name": "title",
                "value": "={{ $json.title }}",
                "type": "string"
              },
              {
                "id": "b",
                "name": "link",
                "value": "={{ $json.link }}",
                "type": "string"
              }
            ]
          }
        },
        "inputs": 1,
        "outputs": 1
      },
      {
        "kind": "output",
        "id": "edit-fields-out",
        "port": "edit_fields"
      }
    ],
    "edges": [
      [
        "rss-read.out",
        "limit.in"
      ],
      [
        "limit.out",
        "edit-fields.in"
      ],
      [
        "edit-fields.out",
        "edit-fields-out.in"
      ]
    ],
    "triggers": [
      {
        "kind": "on-demand"
      }
    ],
    "failure": {
      "retries": 0,
      "on_error": "fail"
    },
    "limits": {
      "llm_calls_per_run": 0,
      "fetches_per_run": 0
    }
  },
  "types": {}
}
