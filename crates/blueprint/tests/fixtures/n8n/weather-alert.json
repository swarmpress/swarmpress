{
  "graph": {
    "format": "swarmpress.tool.v1",
    "id": "weather-alert",
    "name": {
      "en": "Weather alert"
    },
    "description": "Imported from n8n: Weather alert.",
    "inputs": {},
    "outputs": {
      "format_alert": "Json[]"
    },
    "nodes": [
      {
        "kind": "n8n",
        "id": "forecast",
        "name": "Forecast",
        "type": "n8n-nodes-base.httpRequest",
        "version": 4.2,
        "parameters": {
          "method": "GET",
          "url": "https://api.open-meteo.com/v1/forecast?latitude=44.1&longitude=9.7&current=temperature_2m"
        },
        "inputs": 1,
        "outputs": 1
      },
      {
        "kind": "n8n",
        "id": "hot",
        "name": "Hot?",
        "type": "n8n-nodes-base.if",
        "version": 1,
        "parameters": {
          "conditions": {
            "number": [
              {
                "value1": "={{ $json.current.temperature_2m }}",
                "operation": "larger",
                "value2": 30
              }
            ]
          }
        },
        "inputs": 1,
        "outputs": 2
      },
      {
        "kind": "n8n",
        "id": "format-alert",
        "name": "Format alert",
        "type": "n8n-nodes-base.code",
        "version": 2,
        "parameters": {
          "jsCode": "return [{ json: { text: 'Hot: ' + $json.current.temperature_2m } }]"
        },
        "inputs": 1,
        "outputs": 1
      },
      {
        "kind": "output",
        "id": "format-alert-out",
        "port": "format_alert"
      }
    ],
    "edges": [
      [
        "forecast.out",
        "hot.in"
      ],
      [
        "hot.out",
        "format-alert.in"
      ],
      [
        "format-alert.out",
        "format-alert-out.in"
      ]
    ],
    "triggers": [
      {
        "kind": "schedule",
        "every_game_days": 1
      }
    ],
    "failure": {
      "retries": 0,
      "on_error": "fail"
    },
    "limits": {
      "llm_calls_per_run": 0,
      "fetches_per_run": 0
    }
  },
  "types": {}
}
