{
  "$ref": "#/definitions/PageTypes",
  "definitions": {
    "PageTypes": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "swarmpress.page-types.v1"
        },
        "page_types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "label": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string"
                  },
                  "de": {
                    "type": "string"
                  },
                  "fr": {
                    "type": "string"
                  },
                  "it": {
                    "type": "string"
                  }
                },
                "required": [
                  "en"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "default": []
              },
              "route": {
                "type": "string",
                "pattern": "^\\/"
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "blocks": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(x:)?[a-z0-9]+(-[a-z0-9]+)*$"
                      },
                      "minItems": 1
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id",
                    "blocks"
                  ],
                  "additionalProperties": false
                }
              },
              "require": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "block": {
                      "type": "string",
                      "pattern": "^(x:)?[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "block",
                    "min"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "html_fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "block": {
                      "type": "string",
                      "pattern": "^(x:)?[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "field": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "block",
                    "field"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "page_types"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
