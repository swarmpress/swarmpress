{
  "name": "swarm-press",
  "version": "0.2.0",
  "private": true,
  "description": "swarm.press: an isometric publishing-house game where AI staff run a real website",
  "scripts": {
    "dev": "pnpm --filter @swarm-press/game dev",
    "build": "pnpm --filter @swarm-press/game build",
    "typecheck": "pnpm -r --filter @swarm-press/game --filter @swarm-press/content-schema --filter @swarm-press/site-kit --filter @swarm-press/sdk --filter @swarm-press/sandbox --filter @swarm-press/runner typecheck",
    "test": "pnpm -r --filter @swarm-press/content-schema --filter @swarm-press/game test",
    "test:e2e": "pnpm --filter @swarm-press/game test:e2e",
    "test:sdk": "pnpm -r --filter @swarm-press/sdk --filter @swarm-press/sandbox --filter @swarm-press/runner test",
    "test:site-kit": "pnpm --filter @swarm-press/site-kit test",
    "kit": "node packages/site-kit/bin/kit.mjs",
    "swarmpress": "bun packages/runner/src/cli.ts",
    "schema:export": "pnpm --filter @swarm-press/content-schema export",
    "schema:check": "pnpm --filter @swarm-press/content-schema check && pnpm --filter @swarm-press/site-kit schema:check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "onnxruntime-node"
    ]
  }
}
