{
  "name": "swarm-press",
  "version": "0.2.0",
  "private": true,
  "description": "SimPress: an isometric publishing-house game where AI staff run a real website",
  "scripts": {
    "dev": "pnpm --filter @swarm-press/game dev",
    "build": "pnpm --filter @swarm-press/game build",
    "typecheck": "pnpm -r --filter @swarm-press/game --filter @swarm-press/content-schema typecheck",
    "test": "pnpm -r --filter @swarm-press/content-schema --filter @swarm-press/game test",
    "test:e2e": "pnpm --filter @swarm-press/game test:e2e",
    "schema:export": "pnpm --filter @swarm-press/content-schema export",
    "schema:check": "pnpm --filter @swarm-press/content-schema check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "onnxruntime-node"
    ]
  }
}
