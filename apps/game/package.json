{
  "name": "@swarm-press/game",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "swarm.press browser client: Babylon.js (WebGPU) isometric dollhouse view over the Rust/wasm simulation",
  "scripts": {
    "wasm": "cargo xtask wasm",
    "wasm:release": "cargo xtask wasm --release",
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm:release && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bonsai:runtime": "node scripts/bonsai-runtime.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.29.0",
    "@babylonjs/loaders": "^9.29.0",
    "@huggingface/transformers": "^4.3.0",
    "@preact/signals": "^2.3.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "preact": "^10.27.0",
    "smol-toml": "^1.9.0",
    "@tursodatabase/database-wasm": "0.8.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/preact": "^3.2.4",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
