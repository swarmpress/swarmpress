{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"],
    "paths": {
      "swarm-wasm": ["../../crates/client-wasm/pkg/client_wasm"],
      "orchestrator-wasm": ["../../crates/orchestrator-wasm/pkg/orchestrator_wasm"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.orchestrator.config.ts"]
}
